{
  "name": "rt-app",
  "packageManager": "pnpm@11.1.3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:status": "node scripts/db.mjs status",
    "db:seed": "node scripts/db.mjs seed",
    "db:new": "node scripts/db.mjs new",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:biome": "biome lint .",
    "lint:biome:fix": "biome lint --write .",
    "lint:biome:clean": "biome clean",
    "lint:all": "biome lint . --max-diagnostics=300",
    "check": "biome check --max-diagnostics=300 .",
    "check:ci": "biome ci --max-diagnostics=300 .",
    "check:full": "biome ci --max-diagnostics=300 --config-path=biome.full.jsonc .",
    "check:quiet": "biome check . --reporter=summary",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@iconify-json/lucide": "^1.2.143",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "1.12.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
		"@vitest/coverage-v8": "^4.1.11",
		"vitest": "^4.1.11"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
