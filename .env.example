# Salin jadi .env.local lalu isi.

# PostgreSQL. Lokal (docker compose up -d):
DATABASE_URL=postgres://rt:rt@localhost:5432/rt_app
# Hosting (Supabase/Neon/dll) biasanya butuh SSL, tambahkan ?sslmode=require di akhir URL.
# Pakai pooler mode transaksi (Supabase port 6543 / PgBouncer)? Isi DATABASE_PREPARE=false
DATABASE_PREPARE=
DATABASE_POOL_MAX=5

# Kosongkan WA_API_TOKEN untuk mode uji (pesan hanya dicetak ke terminal).
WA_API_TOKEN=
WA_API_URL=https://api.fonnte.com/send
# Nomor format internasional tanpa +, contoh 6281234567890
WA_BENDAHARA=
WA_KETUA_RT=
